# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teqic_yii3
DB_USER=root
DB_PASSWORD=?

HAWI_SSO_URL=http://localhost/hawi-yii3/public
HAWI_SSO_CLIENT_ID=teqic-client
HAWI_SSO_CLIENT_SECRET=?
HAWI_SSO_REDIRECT_URI=http://localhost/teqic-yii3/public/auth/callback

DOREH_URL=http://localhost:3000
